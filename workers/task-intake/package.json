{
  "name": "@agent-tasks/task-intake-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "setup": "node scripts/setup.mjs",
    "cf-typegen": "wrangler types worker-configuration.d.ts --include-runtime false --strict-vars false",
    "test": "npm run test:worker && npm run test:setup",
    "test:worker": "vitest run",
    "test:setup": "node --test test/setup-lib.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run cf-typegen && npm run typecheck && npm test && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.4",
    "@cloudflare/workers-types": "5.20260714.1",
    "typescript": "^5.8.3",
    "vitest": "4.1.0",
    "wrangler": "4.110.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2"
  }
}
