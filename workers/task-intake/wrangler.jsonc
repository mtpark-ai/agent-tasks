{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-task-intake",
  "main": "src/persistent-worker.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-tasks",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_VERSION": "0.2.0",
    "GITHUB_OWNER": "REPLACE_WITH_GITHUB_OWNER",
    "GITHUB_REPO": "REPLACE_WITH_GITHUB_REPO",
    "ISSUE_LABELS": "status:needs-triage,agent:unassigned,type:raw,source:external",
    "MAX_BODY_BYTES": "50000",
    "SHORTCUT_URL": "https://www.icloud.com/shortcuts/5005bf386b2447ca855aec7ecb67fd15"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
